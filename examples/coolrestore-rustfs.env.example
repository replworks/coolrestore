# Copy this file to a protected location such as:
# /etc/coolrestore/rustfs.env
#
# Set permissions on the copied file to owner-only access:
# chmod 600 /etc/coolrestore/rustfs.env

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://rustfs.example.com
AWS_S3_FORCE_PATH_STYLE=true
