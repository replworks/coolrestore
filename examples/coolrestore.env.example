# Copy this file to a protected system location such as:
# /etc/coolrestore/env
#
# For a per-user setup, use ~/.config/coolrestore/env instead.
# Set permissions on the copied file to owner-only access:
# chmod 600 /etc/coolrestore/env

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=https://s3-compatible.example.com
AWS_S3_FORCE_PATH_STYLE=true
